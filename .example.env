# Copy to .env.local and fill in (never commit .env.local).
# Contentful — plot details (unit entries) keyed by hotspotId; geometry stays in data/project.json.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
# Management (CMA) token: lets the editor publish uploaded details. Dev machine only.
CONTENTFUL_MANAGEMENT_TOKEN=
# Delivery (CDA) token: lets the viewer read the published details.
CONTENTFUL_DELIVERY_TOKEN=
# Locale of the fields (default en-US).
CONTENTFUL_LOCALE=en-US
